# Required for a real deployment (Supabase → Settings → API).
VITE_SUPABASE_URL=
# The publishable key (sb_publishable_...). Never put the secret key here.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local development only: set to 1 to run against in-browser fake data (never set this on Vercel).
# VITE_DEMO=1
